{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control and tenant assignment",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["ADMIN", "COMPANY", "WORKER"] },
        "companyId": { "type": "string", "maxLength": 128 },
        "requestedCompanyId": { "type": "string", "maxLength": 128 },
        "requestedCompanyName": { "type": "string", "maxLength": 100 },
        "membershipType": { "type": "string", "enum": ["COMPANY_AFFILIATED", "INDIVIDUAL"] },
        "membershipStatus": { "type": "string", "enum": ["ACTIVE", "PENDING_COMPANY_VERIFICATION", "REJECTED"] },
        "employeeId": { "type": "string", "maxLength": 128 },
        "assignedCompanyIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Designated super administrators with global read/write access",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Company": {
      "title": "Company",
      "description": "Client company entity isolated by companyId",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string", "maxLength": 100 },
        "businessNumber": { "type": "string", "maxLength": 20 },
        "representativeName": { "type": "string", "maxLength": 50 },
        "contactEmail": { "type": "string", "format": "email" },
        "contactPhone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 200 },
        "assignedAttorneyId": { "type": "string", "maxLength": 128 },
        "activeSubscriptionRequestId": { "type": "string", "maxLength": 128 },
        "currentPlanId": { "type": "string", "maxLength": 50 },
        "subscription": {
          "type": "object",
          "properties": {
            "planCode": { "type": "string", "enum": ["FREE", "BASIC", "STANDARD", "CUSTOM", "OUTSOURCING"] },
            "status": { "type": "string", "enum": ["PENDING", "ACTIVE", "EXPIRED", "CANCELLED"] },
            "startDate": { "type": "string" },
            "endDate": { "type": "string" }
          }
        },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "businessNumber", "status"]
    },
    "CompanyDirectory": {
      "title": "CompanyDirectory",
      "description": "Minimal non-sensitive company directory used strictly for public search during onboarding",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "companyName": { "type": "string", "maxLength": 100 },
        "businessNumberMasked": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "companyName"]
    },
    "Worker": {
      "title": "Worker",
      "description": "Worker record belonging strictly to a company",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "maxLength": 30 },
        "department": { "type": "string", "maxLength": 50 },
        "position": { "type": "string", "maxLength": 50 },
        "joinDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["active", "resigned", "on_leave"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "name", "status"]
    },
    "MaternityCase": {
      "title": "MaternityCase",
      "description": "Maternity protection case linked by companyId and employeeId",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "workType": { "type": "string", "maxLength": 50 },
        "applicationDate": { "type": "string", "maxLength": 20 },
        "startDate": { "type": "string", "maxLength": 20 },
        "endDate": { "type": "string", "maxLength": 20 },
        "returnDate": { "type": "string", "maxLength": 20 },
        "assignedAttorneyId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" },
        "completedById": { "type": "string", "maxLength": 128 },
        "internalNotes": { "type": "string", "maxLength": 5000 },
        "createdById": { "type": "string", "maxLength": 128 },
        "updatedById": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "employeeId", "workType", "startDate", "endDate", "status"]
    },
    "MaternityCasePrivate": {
      "title": "MaternityCasePrivate",
      "description": "Isolated administrative notes and confidential attorney annotations strictly accessible by ADMIN",
      "type": "object",
      "properties": {
        "caseId": { "type": "string", "maxLength": 128 },
        "internalNotes": { "type": "string", "maxLength": 10000 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedById": { "type": "string", "maxLength": 128 }
      },
      "required": ["caseId", "internalNotes", "updatedAt", "updatedById"]
    },
    "MaternityDocument": {
      "title": "MaternityDocument",
      "description": "Official documents and attachments submitted for maternity cases",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "caseId": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "documentType": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "fileName": { "type": "string", "maxLength": 200 },
        "fileUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "SUBMITTED", "APPROVED", "REJECTED"] },
        "uploadedById": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["caseId", "companyId", "employeeId", "title", "fileName"]
    },
    "MaternityDocumentPrivate": {
      "title": "MaternityDocumentPrivate",
      "description": "Sensitive administrative review and legal audit notes for maternity documents strictly accessible by ADMIN",
      "type": "object",
      "properties": {
        "documentId": { "type": "string", "maxLength": 128 },
        "internalNotes": { "type": "string", "maxLength": 10000 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedById": { "type": "string", "maxLength": 128 }
      },
      "required": ["documentId", "internalNotes", "updatedAt", "updatedById"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Integrated labor inquiry managed across roles (COMPANY, individual WORKER, and ADMIN)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": ["string", "null"], "maxLength": 128 },
        "companyName": { "type": ["string", "null"], "maxLength": 200 },
        "requesterId": { "type": "string", "maxLength": 128 },
        "requesterName": { "type": "string", "maxLength": 100 },
        "requesterRole": { "type": "string", "enum": ["COMPANY", "WORKER"] },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorRole": { "type": "string", "enum": ["COMPANY", "WORKER"] },
        "type": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["RECEIVED", "IN_PROGRESS", "ANSWERED", "CLOSED", "ASSIGNED"] },
        "answer": { "type": "string", "maxLength": 10000 },
        "answeredAt": { "type": "string", "format": "date-time" },
        "answeredById": { "type": "string", "maxLength": 128 },
        "answeredByName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requesterId", "requesterRole", "requesterName", "title", "content", "status"]
    },
    "InquiryFile": {
      "title": "InquiryFile",
      "description": "Attachment metadata for labor inquiries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "inquiryId": { "type": "string", "maxLength": 128 },
        "companyId": { "type": ["string", "null"], "maxLength": 128 },
        "requesterId": { "type": "string", "maxLength": 128 },
        "uploadedById": { "type": "string", "maxLength": 128 },
        "uploadedByRole": { "type": "string", "enum": ["ADMIN", "COMPANY", "WORKER"] },
        "originalFileName": { "type": "string", "maxLength": 255 },
        "storagePath": { "type": "string", "maxLength": 500 },
        "contentType": { "type": "string", "maxLength": 100 },
        "size": { "type": "number" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "inquiryId", "requesterId", "uploadedById", "uploadedByRole", "originalFileName", "storagePath", "contentType", "size", "uploadedAt"]
    },
    "InquiryHistory": {
      "title": "InquiryHistory",
      "description": "Immutable processing audit trail for integrated labor inquiries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "inquiryId": { "type": "string", "maxLength": 128 },
        "companyId": { "type": ["string", "null"], "maxLength": 128 },
        "requesterId": { "type": "string", "maxLength": 128 },
        "eventType": {
          "type": "string",
          "enum": [
            "INQUIRY_CREATED",
            "INQUIRY_EDITED",
            "STATUS_CHANGED",
            "ANSWER_CREATED",
            "ANSWER_UPDATED",
            "INQUIRY_CLOSED"
          ]
        },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorRole": { "type": "string", "enum": ["ADMIN", "COMPANY", "WORKER"] },
        "actorName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "metadata": {
          "type": "object",
          "properties": {
            "fromStatus": { "type": "string" },
            "toStatus": { "type": "string" }
          }
        }
      },
      "required": ["id", "inquiryId", "requesterId", "eventType", "actorId", "actorRole", "actorName", "createdAt"]
    },
    "UserConsent": {
      "title": "UserConsent",
      "description": "Tracked terms agreement history with versioning and timestamping",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 },
        "termType": { "type": "string", "maxLength": 50 },
        "version": { "type": "string", "maxLength": 20 },
        "agreed": { "type": "boolean" },
        "agreedAt": { "type": "string", "format": "date-time" },
        "withdrawnAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "termType", "version", "agreed", "agreedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Direct communication messages strictly isolated between ADMIN and individual COMPANY clients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 100 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderRole": { "type": "string", "enum": ["ADMIN", "COMPANY"] },
        "senderName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "recipientRole": { "type": "string", "enum": ["ADMIN", "COMPANY"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "senderId", "senderRole", "senderName", "content", "createdAt", "updatedAt"]
    },
    "MessageTemplate": {
      "title": "MessageTemplate",
      "description": "Standard business message templates managed by Admin with active state control",
